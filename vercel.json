{
  "version": 2,
  "name": "learn-sindhi-language",
  "headers": [
    {
      "source": "/extracted_audio/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Content-Type",
          "value": "audio/mpeg"
        }
      ]
    }
  ]
}